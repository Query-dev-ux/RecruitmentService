# Copy to .env and fill in real values. Never commit .env.

ENV=development
LOG_LEVEL=INFO

# Shared secret CRM (or any internal caller) must send as:
#   Authorization: Bearer <INTERNAL_SERVICE_TOKEN>
# Generate a long random value, e.g. `openssl rand -hex 32`.
INTERNAL_SERVICE_TOKEN=changeme-generate-a-long-random-string

# App connects with the async driver.
DATABASE_URL=postgresql+asyncpg://recruitment:changeme@recruitment-postgres:5432/recruitment

# Used by the recruitment-postgres container itself.
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=changeme
POSTGRES_DB=recruitment

# Name of the external Docker network shared with the CRM containers on the
# production server, so recruitment-api is reachable from the CRM backend.
# We don't have access to that server/network ourselves — confirm the real
# name with whoever manages the CRM containers before deploying.
CELESTIAL_NETWORK_NAME=celestial-shared

# --- HH.ru OAuth (not used until the HH provider phase) ---
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
